{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto merge containers",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["digest", "minor", "patch"],
      matchPackageNames: [
        "ghcr.io/home-operations/prowlarr",
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/bazarr",
        "ghcr.io/flaresolverr/flaresolverr",
        "ghcr.io/esphome/esphome",
        "docker.io/cloudflare/cloudflared",
        "ghcr.io/home-operations/actions-runner",
      ],
      ignoreTests: true,
    },
    {
      description: "Auto merge low-risk app patches",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["digest", "patch"],
      matchPackageNames: [
        "ghcr.io/autobrr/autobrr",
        "ghcr.io/cross-seed/cross-seed",
        "ghcr.io/home-operations/sabnzbd",
        "ghcr.io/home-operations/tqm",
        "golift/unpackerr",
        "golift/notifiarr",
        "ghcr.io/seerr-team/seerr",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/home-operations/tautulli",
        "docker.io/remirigal/plex-auto-languages",
        "docker.io/meisnate12/plex-image-cleanup",
        "ghcr.io/taxel/plextraktsync",
        "ghcr.io/mealie-recipes/mealie",
        "actualbudget/actual-server",
        "jhonderson/actual-http-api",
        "ghcr.io/oss-apps/splitpro",
      ],
      ignoreTests: true,
    },
    {
      description: "Auto merge media server patches only overnight, when nobody is streaming",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "branch",
      automergeSchedule: ["* 2-5 * * *"],
      matchUpdateTypes: ["digest", "patch"],
      matchPackageNames: [
        "ghcr.io/home-operations/plex",
        "ghcr.io/jellyfin/jellyfin",
      ],
      ignoreTests: true,
    },
    {
      description: "Auto merge Home Assistant patch",
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["digest", "patch"],
      matchPackageNames: ["ghcr.io/home-operations/home-assistant"],
      ignoreTests: true,
    },
    {
      description: "Auto merge KPS minors and patches",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      ignoreTests: false,
    },
    {
      description: "Auto merge Ghostfolio minors and patches",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/ghostfolio/"],
      ignoreTests: false,
    },
  ],
}
