{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto merge containers",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["digest", "minor", "patch"],
      matchPackageNames: [
        "ghcr.io/home-operations/prowlarr",
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/bazarr",
        "ghcr.io/flaresolverr/flaresolverr",
        "ghcr.io/esphome/esphome",
        "docker.io/cloudflare/cloudflared",
      ],
      ignoreTests: true,
    },
    {
      description: "Auto merge Home Assistant patch",
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["digest", "patch"],
      matchPackageNames: ["ghcr.io/home-operations/home-assistant"],
      ignoreTests: true,
    },
    {
      description: "Auto merge KPS minors and patches",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      ignoreTests: false,
    },
    {
      description: "Auto merge Ghostfolio minors and patches",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/ghostfolio/"],
      ignoreTests: false,
    },
  ],
}
