{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>bjw-s/renovate-config",
    "github>bjw-s/renovate-config:automerge-github-actions",
    "github>D-o-c-labs/Doc-Home-ops//.renovate/allowedVersions.json5",
    "github>D-o-c-labs/Doc-Home-ops//.renovate/autoMerge.json5",
    "github>D-o-c-labs/Doc-Home-ops//.renovate/versioning.json5",
    "github>D-o-c-labs/Doc-Home-ops//.renovate/groups.json5",
    "github>D-o-c-labs/Doc-Home-ops//.renovate/customManagers.json5",
    "config:recommended",
    ":dependencyDashboard",
  ],
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.ya?ml$/"],
  },
  customManagers: [
    {
      customType: "regex",
      description: "Update Talos version in tuppr upgrades Kustomization",
      managerFilePatterns: [
        "/(^|/)kubernetes/apps/system-upgrade/tuppr/ks\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: depName=siderolabs/talos datasource=custom.talos-factory\\r?\\n(?<indentation>\\s+)TALOS_VERSION: (?<currentValue>\\S+)",
      ],
      // Same depName and datasource as the talosFactory preset (topf.yaml talosVersion), so both bumps land in one PR.
      // ghcr.io/siderolabs/installer is no longer published from Talos 1.14.
      depNameTemplate: "siderolabs/talos",
      autoReplaceStringTemplate: "# renovate: depName=siderolabs/talos datasource=custom.talos-factory\n{{{indentation}}}TALOS_VERSION: {{{newValue}}}",
      datasourceTemplate: "custom.talos-factory",
      versioningTemplate: "semver",
    },
    {
      customType: "regex",
      description: "Update Kubernetes version in tuppr upgrades Kustomization",
      managerFilePatterns: [
        "/(^|/)kubernetes/apps/system-upgrade/tuppr/ks\\.ya?ml$/",
      ],
      matchStrings: [
        "# renovate: depName=ghcr.io/siderolabs/kubelet datasource=docker\\r?\\n(?<indentation>\\s+)KUBERNETES_VERSION: (?<currentValue>\\S+)",
      ],
      depNameTemplate: "ghcr.io/siderolabs/kubelet",
      autoReplaceStringTemplate: "# renovate: depName=ghcr.io/siderolabs/kubelet datasource=docker\n{{{indentation}}}KUBERNETES_VERSION: {{{newValue}}}",
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Update Kubernetes version in topf.yaml",
      managerFilePatterns: ["/(^|/)kubernetes/talos/topf\\.ya?ml$/"],
      matchStrings: [
        "# renovate: depName=ghcr.io/siderolabs/kubelet datasource=docker\\r?\\n(?<indentation>\\s*)kubernetesVersion: (?<currentValue>\\S+)",
      ],
      depNameTemplate: "ghcr.io/siderolabs/kubelet",
      autoReplaceStringTemplate: "# renovate: depName=ghcr.io/siderolabs/kubelet datasource=docker\n{{{indentation}}}kubernetesVersion: {{{newValue}}}",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      description: "Let infra releases and apps that publish pre-releases under normal tags soak for a week",
      matchPackageNames: [
        "/cilium/",
        "/rook-ceph/",
        "/cert-manager/",
        "/siderolabs/",
        "/flux-operator/",
        "/flux-instance/",
        "/controlplaneio-fluxcd/",
        "/envoyproxy/",
        "/n8n/",
        "/sonarr/",
      ],
      minimumReleaseAge: "7 days",
      // Some OCI chart registries return no release timestamp; don't hold those updates forever.
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      description: "Widen Python ranges instead of narrowing them to the new minor",
      matchManagers: ["pip_requirements"],
      rangeStrategy: "widen",
    },
    {
      description: "Enforce sequential minor upgrades for tuppr versions",
      matchFileNames: ["kubernetes/apps/system-upgrade/tuppr/ks.yaml"],
      matchDatasources: ["docker", "custom.talos-factory"],
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/kubelet"],
      postUpgradeTasks: {
        commands: [
          "scripts/renovate/ensure-next-minor.sh kubernetes/apps/system-upgrade/tuppr/ks.yaml",
        ],
        fileFilters: ["kubernetes/apps/system-upgrade/tuppr/ks.yaml"],
      },
    },
  ],
}
